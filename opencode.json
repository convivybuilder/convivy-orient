{
  "$schema": "https://opencode.ai/config.json",
  "model": "convivy-gateway/deepseek",
  "provider": {
    "convivy-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Convivy LiteLLM gateway",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:OPENCODE_GATEWAY_KEY}",
        "headers": { "x-agentctl-agent": "opencode-trial" }
      },
      "models": {
        "deepseek": { "name": "DeepSeek V3 (deepseek-chat)" },
        "kimi": { "name": "Kimi k2.6 (moonshot)" },
        "gpt5": { "name": "GPT-5 (openai)" }
      }
    }
  },
  "mcp": {
    "kb": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/mcp-kb-server"],
      "enabled": true
    }
  }
}
